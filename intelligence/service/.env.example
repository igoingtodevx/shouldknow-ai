# Environment for the Should Know intelligence service on the VPS.
# Host-run mode (current): postgres runs containerized via docker-compose.intelligence.yml
# published on the host loopback; SearXNG listens on 127.0.0.1:8888; the Crawl4AI bridge
# (intelligence/crawl4ai_bridge.py) listens on 127.0.0.1:11235.
# Container mode: replace the host with the compose service name (postgres, searxng).
DATABASE_URL=postgresql://shouldknow:change-me@127.0.0.1:5432/shouldknow
SEARXNG_URL=http://127.0.0.1:8888
CRAWL4AI_ENDPOINT=http://127.0.0.1:11235/crawl
# Keep a strong random value only on the VPS. If omitted, review mutation endpoints
# are disabled (503). Never expose this token to the Vite frontend.
SHOULDKNOW_ADMIN_TOKEN=replace-with-a-long-random-secret
# Kept for documentation compatibility; code intentionally ignores this for now.
AUTO_PUBLISH_P0=false
