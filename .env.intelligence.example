POSTGRES_PASSWORD=change-me-to-a-long-random-password
CORS_ORIGINS=https://shouldknow-ai.vercel.app,http://localhost:5173
SHOULDKNOW_API_PORT=8787

# Existing self-hosted services. JSON output must be enabled in SearXNG.
SEARXNG_URL=http://host.docker.internal:8080
CRAWL4AI_URL=http://host.docker.internal:11235
CRAWL4AI_API_TOKEN=

# Optional OpenAI-compatible reviewer (Hermes/local gateway/provider).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Start conservatively. Review candidate quality before enabling auto-publish.
MATERIALITY_THRESHOLD=45
AUTO_PUBLISH=false
AUTO_PUBLISH_THRESHOLD=78
AUTO_PUBLISH_CONFIDENCE=0.84
SCAN_INTERVAL_MINUTES=240
